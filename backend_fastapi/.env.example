# Backend configuration for OceanConnect Backend API
# Copy to .env and fill in values. Do NOT commit real secrets.

# Comma separated list of origins allowed for CORS, e.g. http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000

# Optional: where to redirect browser after successful OAuth callback
# e.g. http://localhost:3000/auth/callback
FRONTEND_REDIRECT_AFTER_AUTH=

# JIRA OAuth 2.0 (3LO)
JIRA_OAUTH_CLIENT_ID=
JIRA_OAUTH_CLIENT_SECRET=
JIRA_OAUTH_REDIRECT_URI=http://localhost:8000/auth/jira/oauth/callback

# CONFLUENCE OAuth 2.0 (3LO)
CONFLUENCE_OAUTH_CLIENT_ID=
CONFLUENCE_OAUTH_CLIENT_SECRET=
CONFLUENCE_OAUTH_REDIRECT_URI=http://localhost:8000/auth/confluence/oauth/callback

# Logging level (DEBUG, INFO, WARN, ERROR)
LOG_LEVEL=INFO
