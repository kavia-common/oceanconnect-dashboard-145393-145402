# FastAPI backend environment configuration (example)
# Copy to .env and fill in real values for local/dev

# Logging
LOG_LEVEL=INFO

# CORS
ALLOWED_ORIGINS=http://localhost:3000

# Jira OAuth (3LO) configuration
JIRA_OAUTH_CLIENT_ID=YOUR_JIRA_CLIENT_ID
JIRA_OAUTH_CLIENT_SECRET=YOUR_JIRA_CLIENT_SECRET
JIRA_OAUTH_REDIRECT_URI=http://localhost:8000/auth/callback

# Optional scope override (space-delimited)
# JIRA_OAUTH_SCOPE=read:jira-user read:jira-work read:me offline_access

# Optional frontend redirect after successful auth (not used in this minimal flow)
# FRONTEND_REDIRECT_AFTER_AUTH=http://localhost:3000/oauth/callback
